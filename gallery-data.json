name: Auto Generate Gallery JSON

on:
  push:
    branches:
      - main
    paths:
      - 'Photos/**'
      - 'Videos/**'

jobs:
  update-gallery:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Build gallery-data.json
        run: |
          node -e '
          const fs = require("fs");
          const path = require("path");

          function scanFolder(dir) {
            if (!fs.existsSync(dir)) return [];
            let files = [];
            const items = fs.readdirSync(dir, { withFileTypes: true });
            for (const item of items) {
              const fullPath = path.join(dir, item.name).replace(/\\/g, "/");
              if (item.isDirectory()) {
                files = files.concat(scanFolder(fullPath));
              } else if (!item.name.startsWith(".") && item.name !== "nfile") {
                files.push(fullPath);
              }
            }
            return files;
          }

          const photoFiles = scanFolder("Photos");
          const videoFiles = scanFolder("Videos");
          const media = [];

          // Process root cover photo if present
          if (fs.existsSync("Beyond Thirst project cover.png")) {
            media.push({
              src: "Beyond Thirst project cover.png",
              name: "Beyond Thirst Cover Image",
              album: "campaigns",
              type: "image"
            });
          }

          // Process photos
          photoFiles.forEach(file => {
            const ext = path.extname(file).toLowerCase();
            if ([".jpg", ".jpeg", ".png", ".webp", ".gif"].includes(ext)) {
              const baseName = path.basename(file, ext).replace(/[-_]/g, " ");
              const parts = file.split("/");
              const albumName = parts.length > 2 ? parts[1].toLowerCase().replace(/\s+/g, "-") : "highlights";
              media.push({
                src: file,
                name: baseName,
                album: albumName,
                type: "image"
              });
            }
          });

          // Process videos
          videoFiles.forEach(file => {
            const ext = path.extname(file).toLowerCase();
            if ([".mp4", ".webm", ".mov"].includes(ext)) {
              const baseName = path.basename(file, ext).replace(/[-_]/g, " ");
              media.push({
                src: file,
                name: baseName,
                album: "videos",
                type: "video"
              });
            }
          });

          const albums = [
            { id: "campaigns", title: "Community Campaigns", tag: "Campaigns", description: "Awareness drives and student pledges", cover: "Beyond Thirst project cover.png" },
            { id: "project-highlights", title: "Project Highlights", tag: "Highlights", description: "Key moments and team action photos", cover: photoFiles[0] || "" },
            { id: "videos", title: "Videos & Reels", tag: "Videos", description: "Documentaries and clips", cover: videoFiles[0] || "" }
          ];

          fs.writeFileSync("gallery-data.json", JSON.stringify({ albums, media }, null, 2));
          '

      - name: Commit and Push Updated JSON
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add gallery-data.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "auto: update gallery-data.json" && git push)
